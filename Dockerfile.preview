# Preview image: one per pull request (docs/preview-environments.md).
# The API in PREVIEW_MODE plus the built admin (admin/dist), served by Express on one origin.
# The same image runs the migrate + seed job (scripts/preview/migrate-and-seed.sh).
#
#   docker build -f Dockerfile.preview -t effekt-preview .
#
# Uses Dockerfile.preview.dockerignore (BuildKit picks it over .dockerignore), so the production
# Dockerfile, its .dockerignore (which excludes admin/) and its image are unchanged.

# ---- Build ----
FROM node:24.22.1 AS build

WORKDIR /usr/src/app
RUN corepack enable
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CHECKPOINT_DISABLE=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY admin/package.json admin/package.json

# --ignore-scripts: prisma generate runs below once the schema is there; husky is not wanted
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .
RUN pnpm exec prisma generate
RUN pnpm run build

# The seed (prisma/seed.ts -> prisma/devdata, which imports src/custom_modules/regranting)
# compiled to plain JS, so the release image needs neither ts-node nor typescript.
RUN pnpm exec tsc --outDir dist-seed --rootDir . --module commonjs --target ES2022 \
      --esModuleInterop --skipLibCheck --strictNullChecks --allowJs false prisma/seed.ts

# Admin: preview auth ("Continue as…"), same-origin API. Allowed only with --mode preview.
RUN VITE_AUTH_MODE=preview pnpm --dir admin run build:preview

# ---- Release ----
FROM node:24.22.1

WORKDIR /usr/src/app
RUN corepack enable
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CHECKPOINT_DISABLE=1 NO_UPDATE_NOTIFIER=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml prisma.config.ts ./
COPY prisma ./prisma

# Production dependencies of the backend only. Prisma's engines (for `migrate deploy` and
# `db execute` in the seed job) are fetched by rebuilding just the Prisma packages.
RUN pnpm install --frozen-lockfile --prod --ignore-scripts --filter stiftelsen-effekt-backend \
    && pnpm rebuild prisma @prisma/engines @prisma/client

COPY --from=build /usr/src/app/dist ./dist
COPY --from=build /usr/src/app/dist-seed ./dist-seed
COPY --from=build /usr/src/app/admin/dist ./admin-dist
COPY --from=build /usr/src/app/scripts/preview/migrate-and-seed.sh ./scripts/preview/migrate-and-seed.sh

# Previews always run in preview mode; the startup guard refuses anything that isn't a safe
# preview (src/custom_modules/preview/environmentGuard.ts). Cloud Run provides PORT.
ENV NODE_ENV=preview \
    PREVIEW_MODE=true \
    PREVIEW_ADMIN_DIR=/usr/src/app/admin-dist \
    EFFEKT_HOST=0.0.0.0 \
    TRUST_PROXY_HOPS=1

USER node
EXPOSE 8080
CMD ["node", "dist/server.js"]
