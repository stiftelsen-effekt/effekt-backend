{
  "name": "effekt-studio",
  "private": true,
  "version": "1.0.0",
  "description": "The Sanity Studio, built into the website at /studio",
  "author": "Håkon Harnes <account@harnes.me>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "sanity dev",
    "build": "sanity build",
    "typecheck": "tsc --noEmit",
    "installtable": "sanity install table",
    "edit": "export EDITOR=\"code -w\" && node scripts/editDocument.js",
    "list:pages": "node scripts/listPages.js",
    "typegen": "dotenv run -f ../.env.local -- sanity schema extract --force && sanity typegen generate --config-path sanity-typegen.json",
    "lint": "oxlint",
    "format": "prettier --write . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "test": "vitest run"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/table": "^3.1.17",
    "@sanity/ui": "^4.3.0",
    "@sanity/vision": "^6.17.0",
    "date-fns": "^4.4.0",
    "katex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-feather": "catalog:",
    "sanity": "^6.17.0",
    "styled-components": "catalog:"
  },
  "devDependencies": {
    "@effekt/config": "workspace:*",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:native",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
