{
  "name": "main-site",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "browser": {
    "./lib/sanity.client.ts": "./lib/sanity.client.browser.ts"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node build-studio.mjs",
    "build": "pnpm types:api && next build",
    "sanity": "dotenv run -f .env.local -- pnpm --dir studio start",
    "sanity:edit": "dotenv run -f .env.local -- pnpm --dir studio edit",
    "sanity:list:pages": "dotenv run -f .env.local -- pnpm --dir studio list:pages",
    "deploy-dk-dataset": "node scripts/deploy-dk-dataset.js",
    "start": "next start",
    "lint": "oxlint",
    "cypress:no": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress open --config-file cypress-no.config.ts",
    "cypress:no:headless": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress run --config-file cypress-no.config.ts",
    "cypress:dk": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress open --config-file cypress-dk.config.ts",
    "types:api": "pnpm --dir ../api build:types",
    "typecheck": "pnpm types:api && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "next experimental-analyze",
    "generate:wealthmountain": "npx tsx components/main/blocks/WealthCalculator/data/processInput.ts",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@auth0/auth0-react": "catalog:",
    "@observablehq/plot": "^0.6.17",
    "@portabletext/react": "^8.0.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@sanity/client": "^8.10.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-kit": "^6.2.0",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.1.3",
    "@ssfbank/norwegian-id-validators": "^1.0.0",
    "@stdlib/stats-base-dists-truncated-normal": "^0.2.3",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@upstash/redis": "^1.39.0",
    "cookies-next": "^6.1.1",
    "d3": "^7.9.0",
    "html-react-parser": "^6.1.9",
    "katex": "catalog:",
    "luxon": "^3.7.2",
    "next": "^16.4.2",
    "next-plausible": "^4.0.0",
    "next-sanity": "^13.3.4",
    "next-seo": "^7.3.0",
    "norwegian-workdays": "github:stiftelsen-effekt/norwegian-workdays#v1.1.0",
    "organisationsnummer": "^1.2.0",
    "personnummer": "^3.3.1",
    "react": "catalog:",
    "react-animate-height": "^3.2.4",
    "react-device-detect": "^2.2.3",
    "react-dom": "catalog:",
    "react-draggable": "^4.7.2",
    "react-feather": "catalog:",
    "react-hook-form": "catalog:",
    "react-hook-inview": "^4.6.0",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.3.0",
    "react-toastify": "^11.1.0",
    "react-youtube": "^10.1.0",
    "redux-saga": "^1.5.1",
    "sanity-image": "^1.3.0",
    "sass": "^1.106.1",
    "styled-components": "catalog:",
    "swr": "^2.5.1",
    "textures": "^1.2.3",
    "use-debounce": "^10.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effekt/api": "workspace:*",
    "@effekt/config": "workspace:*",
    "@types/d3": "^7.4.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "catalog:",
    "csv-parse": "^7.0.3",
    "cypress": "^16.2.0",
    "cypress-dotenv": "^3.0.1",
    "cypress-fail-fast": "^8.2.0",
    "cypress-localstorage-commands": "^2.3.1",
    "dotenv": "^18.0.8",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "typescript-fsa": "^3.0.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
