{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/node.tsbuildinfo",
    "verbatimModuleSyntax": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "playwright.prod-smoke.config.ts", "tests"]
}
