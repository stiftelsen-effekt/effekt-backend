{
  "extends": "@effekt/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "sourceMap": false,
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "downlevelIteration": true,
    // Not fully strict yet: only strictNullChecks of the base's strict family
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-types"]
}
