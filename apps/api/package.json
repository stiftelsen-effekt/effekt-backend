{
  "name": "stiftelsen-effekt-backend",
  "version": "0.0.1",
  "description": "Backend for stiftelsen gi effektivt sitt donasjonsystem",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:types": "node scripts/build-types.mjs",
    "build": "copyfiles -u 1 src/static/* src/views/**/* src/views/**/**/* src/views/**/**/**/* dist/ && tsc -p tsconfig.build.json",
    "start": "node ./dist/server.js",
    "dev": "cross-env NODEMON=true NODE_ENV=development nodemon src/server.ts",
    "dev-windows": "cross-env NODEMON=true nodemon src/server.ts",
    "debug": "cross-env NODEMON=true nodemon --exec 'node --inspect=0.0.0.0:9229 --require ts-node/register src/server.ts'",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stiftelsen-effekt/effekt-platform.git"
  },
  "author": "Håkon Harnes",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/stiftelsen-effekt/effekt-platform/issues"
  },
  "homepage": "https://github.com/stiftelsen-effekt/effekt-platform#readme",
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@navikt/fnrvalidator": "^1.2.0",
    "@prisma/client": "^7.10.1",
    "@trpc/server": "^11.19.0",
    "@types/luxon": "^3.3.0",
    "@types/ssh2-sftp-client": "^9.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "apicache": "1.6.3",
    "basic-auth": "^1.1.0",
    "body-parser": "^1.19.0",
    "chalk": "^2.4.2",
    "chardet": "^2.0.0",
    "compression": "^1.8.2",
    "csv-parse": "^5.3.3",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.0.3",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "express-bearer-token": "^2.4.0",
    "express-fileupload": "^1.2.0",
    "express-oauth2-jwt-bearer": "1.5.0",
    "express-prettify": "0.0.7",
