{
  "name": "effekt-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root of the effekt platform: the API (apps/api), the admin (apps/admin) and the website (apps/web)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm build:types && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:types": "pnpm --filter stiftelsen-effekt-backend build:types",
    "dev": "pnpm --filter stiftelsen-effekt-backend dev",
    "start": "pnpm --filter stiftelsen-effekt-backend start",
    "api:dev": "pnpm --filter stiftelsen-effekt-backend dev",
    "api:build": "pnpm --filter stiftelsen-effekt-backend build",
    "api:typecheck": "pnpm --filter stiftelsen-effekt-backend typecheck",
    "api:test": "pnpm --filter stiftelsen-effekt-backend test",
    "admin:dev": "pnpm --filter effekt-admin-v2 dev",
    "admin:build": "pnpm --filter effekt-admin-v2 build",
    "admin:typecheck": "pnpm --filter effekt-admin-v2 typecheck",
    "admin:test": "pnpm --filter effekt-admin-v2 test",
    "dev:env:up": "docker compose -f compose.dev.yml up -d --build --wait",
    "dev:env:down": "docker compose -f compose.dev.yml down",
    "dev:env:reset": "docker compose -f compose.dev.yml down -v && pnpm dev:env:up",
    "dev:env:logs": "docker compose -f compose.dev.yml logs -f api",
    "dev:token": "sh scripts/dev-token.sh",
    "dev:data:topup": "docker compose -f compose.dev.yml run --rm --no-deps migrate",
    "e2e:fullstack": "bash scripts/e2e-fullstack.sh",
    "e2e:env:up": "docker compose -f compose.dev.yml -f compose.e2e.yml build migrate && docker compose -f compose.dev.yml -f compose.e2e.yml up -d --wait",
    "e2e:env:down": "docker compose -f compose.dev.yml -f compose.e2e.yml down -v --remove-orphans",
    "web:dev": "pnpm --filter main-site dev",
    "web:build": "pnpm --filter main-site build",
    "web:typecheck": "pnpm --filter main-site typecheck",
    "web:test": "pnpm --filter main-site test",
    "web:lint": "pnpm --filter main-site lint",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stiftelsen-effekt/effekt-platform.git"
  },
  "license": "ISC",
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^17.6.0",
    "prettier": "catalog:"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "schema.prisma": "pnpm --dir apps/api exec prisma format --schema"
  },
  "packageManager": "pnpm@12.15.0"
}
