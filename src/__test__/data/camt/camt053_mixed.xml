        <Amt Ccy="SEK">300</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <BookgDt><Dt>2025-03-04</Dt></BookgDt>
        <BkTxCd><Domn><Cd>PMNT</Cd><Fmly><Cd>RDDT</Cd><SubFmlyCd>PMDD</SubFmlyCd></Fmly></Domn></BkTxCd>
        <NtryDtls>
          <TxDtls>
            <Refs><AcctSvcrRef>TXREF005</AcctSvcrRef></Refs>
            <AmtDtls><TxAmt><Amt Ccy="SEK">300</Amt></TxAmt></AmtDtls>
          </TxDtls>
        </NtryDtls>
      </Ntry>
      <!-- 6: tx-level PMDD and AG Löpnr message, skipped; one normal tx without name/messages kept -->
      <Ntry>
        <Amt Ccy="SEK">900</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <BookgDt><Dt>2025-03-05</Dt></BookgDt>
        <NtryDtls>
          <TxDtls>
            <Refs><AcctSvcrRef>TXREF006A</AcctSvcrRef></Refs>
            <AmtDtls><TxAmt><Amt Ccy="SEK">100</Amt></TxAmt></AmtDtls>
            <BkTxCd><Domn><Cd>PMNT</Cd><Fmly><Cd>RDDT</Cd><SubFmlyCd>PMDD</SubFmlyCd></Fmly></Domn></BkTxCd>
          </TxDtls>
          <TxDtls>
            <Refs><AcctSvcrRef>TXREF006B</AcctSvcrRef></Refs>
            <AmtDtls><TxAmt><Amt Ccy="SEK">200</Amt></TxAmt></AmtDtls>
            <RmtInf><Ustrd>AG Löpnr 000123</Ustrd></RmtInf>
          </TxDtls>
          <TxDtls>
            <Refs><AcctSvcrRef>TXREF006C</AcctSvcrRef></Refs>
            <AmtDtls><TxAmt><Amt Ccy="SEK">600.25</Amt></TxAmt></AmtDtls>
            <RltdPties><UltmtDbtr><Nm></Nm></UltmtDbtr></RltdPties>
          </TxDtls>
          <TxDtls>
            <Refs><AcctSvcrRef>TXREF006D</AcctSvcrRef></Refs>
            <RmtInf><Ustrd><![CDATA[CDATA <msg> 33334444]]></Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
      <!-- 7: entry-level AG Löpnr without TxDtls, skipped -->
      <Ntry>
        <Amt Ccy="SEK">150</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <BookgDt><Dt>2025-03-05</Dt></BookgDt>
        <AcctSvcrRef>ENTRYREF007</AcctSvcrRef>
        <NtryDtls><RmtInf><Ustrd>AG Löpnr 000999</Ustrd></RmtInf></NtryDtls>
      </Ntry>
    </Stmt>
  </BkToCstmrStmt>
