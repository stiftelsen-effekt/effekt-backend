VITE_API_URL=http://localhost:5050

# auth0 (default) or dev (local mock OIDC, never in production builds)
VITE_AUTH_MODE=auth0
VITE_AUTH_DOMAIN=gieffektivt.eu.auth0.com
VITE_AUTH_CLIENT_ID=
VITE_AUTH_AUDIENCE=https://data.gieffektivt.no

# Only used when VITE_AUTH_MODE=dev. Proxied by the Vite dev server to the mock OIDC server on :8090.
VITE_DEV_AUTH_TOKEN_URL=/dev-auth/effekt/token
