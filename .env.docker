# Environment for the local docker environment (compose.dev.yml).
# Committed on purpose: every value here is local-only and non-secret.
# Never put real keys here. Third-party integrations are deliberately blank so nothing external
# (Vipps, Mastercard Payment Services, MailerSend, Mailchimp, Auth0, ...) is called.
#
# Every variable the backend reads is listed explicitly (even when blank) so a
# stray real .env can never fill in a value: dotenv does not override variables
# that are already set.

NODE_ENV=development
TS_NODE_TRANSPILE_ONLY=true
EFFEKT_HOST=0.0.0.0
EFFEKT_PORT=5050
TRUST_PROXY_HOPS=1
EFFEKT_API_URL=http://localhost:5050
MIN_SIDE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_PRODUCTION_ORIGINS=http://localhost:3000
REVALIDATE_TOKEN=
REDIS_URL=

# Database (the `db` service in compose.dev.yml)
DB_HOST=db
DB_NAME=EffektDonasjonDB_Local
DB_USER=root
DB_PASS=effekt-local
DB_URL=mysql://root:effekt-local@db:3306/EffektDonasjonDB_Local
CLOUD_SQL_CONNECTION_NAME=
# K_SERVICE must stay unset (even "" switches DAO to the Cloud SQL unix socket).

# Auth: the local mock OIDC issuer (the `auth` service). Tokens: npm run -s dev:token
# AUTH_AUDIENCE and AUTH_USER_ID_CLAIM must match JSON_CONFIG in compose.dev.yml.
AUTH_BASE_URL=http://auth:8080/effekt
AUTH_AUDIENCE=http://localhost:5050
AUTH_MCP_AUDIENCE=http://localhost:5050/mcp
AUTH_ADDITIONAL_ISSUERS=
AUTH_USER_ID_CLAIM=https://gieffektivt.no/user-id
AUTH_USER_METADATA_KEY=gieffektivt-user-id
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MCP_CLIENT_ID=local-mcp-client
AUTH0_MCP_CLIENT_SECRET=
AUTH0_LOG_STREAM_TOKEN=
AUTH0_REGISTER_TOKEN=

# MCP analysis DB (disabled locally)
MCP_SECRET=
MCP_DB_USER=
MCP_DB_PASS=
MCP_DB_NAME=
MCP_RESOURCE_URL=http://localhost:5050/mcp

# Mail
MAILERSEND_API_KEY=
MAILERSEND_SURVEY_WEBHOOK_SECRET=
MAILERSEND_SECURITY_RECIPIENTS=
MAILERSEND_DONATION_RECEIPT_TEMPLATE_ID=
MAILERSEND_FIRST_DONATION_RECEIPT_TEMPLATE_ID=
MAILERSEND_DONATION_REGISTERED_TEMPLATE_ID=
MAILERSEND_AVTALEGIRO_NOTIFICATION_TEMPLATE_ID=
MAILERSEND_PAYMENT_INTENT_FOLLOWUP_TEMPLATE_ID=
MAILERSEND_SANITY_SECURITY_NOTIFICATION_TEMPLATE_ID=
MAILERSEND_INFLATION_ADJUSTMENT_TEMPLATE_ID=
MAILERSEND_PASSWORD_RESET_NO_USER_TEMPLATE_ID=
MAILERSEND_TEST_WELCOME_RECEIPT_TEMPLATE_A=
MAILERSEND_TEST_WELCOME_RECEIPT_TEMPLATE_B=
MAILERSEND_MISSING_TAX_UNIT_NOTICE_TEMPLATE_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=
SURVEY_EXPORT_SECRET=

# Payments
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_OCP_APIM_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_RECURRING_WEBHOOK_SECRET=
# Mastercard Payment Services SFTP (AvtaleGiro / OCR Giro). The old NETS_* names still work.
GIRO_SFTP_SERVER=
GIRO_SFTP_USER=
GIRO_SFTP_PRIVATE_KEY=
GIRO_SFTP_PRIVATE_KEY_PASSPHRASE=
GIRO_CUSTOMER_ID=
BANK_ACCOUNT=

# Misc integrations
INFLATION_ADJUSTMENT_SUCCESS_SLUG=
INFLATION_ADJUSTMENT_ERROR_SLUG=
TIDBYT_PUSH_ENABLED=false
TIDBYT_WORKER_URL=
TIDBYT_WORKER_AUTH_TOKEN=

# Tooling telemetry/update checks off (Prisma checkpoint, npm/nodemon update notifier)
CHECKPOINT_DISABLE=1
NO_UPDATE_NOTIFIER=1
